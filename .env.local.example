# Copy this file to `.env.local` (which is git-ignored) and fill in the value.

# Google Apps Script Web App URL that receives contact-form submissions and
# writes them to the Google Sheet. Setup instructions are at the top of
# scripts/google-sheets-endpoint.gs
#
# Until this is set, the contact form falls back to opening the visitor's own
# mail client and says so plainly on the page — it never pretends to send.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Forum: Supabase project URL and its public "anon" key (Settings -> API in
# the Supabase dashboard). Read directly by the browser for fast, public
# lookups (comment lists, reaction counts, RSVP counts) -- safe to expose,
# that's what the anon key is for. Run scripts/supabase-forum-schema.sql in
# the project's SQL Editor once, before this does anything useful.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Forum: Google Apps Script Web App URL that receives every Forum write
# (comments, reactions, RSVPs, opportunity suggestions, introduction
# requests, questions, newsletter signups) and inserts them into Supabase
# using its service-role key, which lives only in that script's own Script
# Properties. Setup instructions are at the top of scripts/forum-endpoint.gs
#
# Until this is set, every Forum form is visible but submitting does
# nothing (it says so plainly, same principle as the contact form above).
NEXT_PUBLIC_FORUM_ENDPOINT=
