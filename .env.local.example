# Copy this file to `.env.local` (which is git-ignored) and fill in the value.

# Google Apps Script Web App URL that receives contact-form submissions and
# writes them to the Google Sheet. Setup instructions are at the top of
# scripts/google-sheets-endpoint.gs
#
# Until this is set, the contact form falls back to opening the visitor's own
# mail client and says so plainly on the page — it never pretends to send.
NEXT_PUBLIC_CONTACT_ENDPOINT=
